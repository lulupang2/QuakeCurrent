{
  "name": "@quakecurrent/api-client",
  "version": "0.1.0",
  "description": "TypeScript REST and WebSocket client for QuakeCurrent.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ws": {
      "types": "./dist/ws.d.ts",
      "import": "./dist/ws.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {},
  "dependencies": {},
  "devDependencies": {}
}

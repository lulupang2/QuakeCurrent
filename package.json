{
  "name": "quakecurrent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev -w @quakecurrent/web",
    "build": "npm run build -w @quakecurrent/web",
    "start": "npm run start -w @quakecurrent/web",
    "test": "npm run test -w @quakecurrent/web",
    "test:client": "npm test -w @quakecurrent/api-client",
    "test:e2e": "npm run test:e2e -w @quakecurrent/web",
    "test:e2e:run": "npm run test:e2e:run -w @quakecurrent/web",
    "test:ssr": "npm run test:ssr -w @quakecurrent/web",
    "typecheck": "npm run typecheck -w @quakecurrent/api-client && npm run typecheck -w @quakecurrent/web",
    "lint": "npm run lint -w @quakecurrent/web",
    "generate:api-contract": "npm run contract:generate -w @quakecurrent/api-client",
    "check:api-contract": "npm run contract:check -w @quakecurrent/api-client",
    "check:api-client-contract": "npm run contract:check-types -w @quakecurrent/api-client",
    "api:up": "docker compose up --build",
    "api:down": "docker compose down"
  },
  "type": "module"
}
